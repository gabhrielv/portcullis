# segredos e estado — desde o primeiro commit
*.tfvars
!*.tfvars.example
.env
!.env.example
*.pem
*.key
# o .terraform.lock.hcl É versionado: fixa a versão do provider, não tem segredo
.terraform/
terraform.tfstate
terraform.tfstate.backup
# o Terraform despeja o state INTEIRO aqui quando nao consegue gravar no
# backend: mesmo conteudo do tfstate, mesmo risco de segredo em texto puro
errored.tfstate
.terraform.tfstate.lock.info
crash.log
crash.*.log
# plano binario: carrega os valores ja' resolvidos, inclusive os sensiveis
*.tfplan
tfplan

# artefatos de build (regras do semgrep, zip das lambdas)
build/
# saída do `make corpus`: medição, não código
corpus/placares/

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
# o pytest-cov paralelo grava um arquivo por processo, e o xml do relatorio
.coverage.*
coverage.xml

# sistema
.DS_Store
