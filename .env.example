# Copie para .env e preencha. O .env está no .gitignore.
AWS_REGION=us-east-1

# Preenchidos pelos outputs do Terraform
PRA_BUCKET_PACOTES=
PRA_FILA_URL=
PRA_TABELA=
PRA_FUNCAO_ANALISADOR=

# Nomes dos parâmetros no SSM — nunca os valores
PRA_PARAM_CHAVE_APP=/pra/github/chave-privada
PRA_PARAM_SEGREDO_WEBHOOK=/pra/github/segredo-webhook
PRA_GITHUB_APP_ID=

# Idem para o modelo. Os dois precisam ficar sob /pra/llm/ — é o prefixo
# que a política IAM da investigadora libera.
PRA_PARAM_CHAVE_LLM=/pra/llm/chave
PRA_PARAM_MODELO_LLM=/pra/llm/modelo
