# Copie para .env e preencha. O .env está no .gitignore.
AWS_REGION=us-east-1

# Preenchidos pelos outputs do Terraform
PORTCULLIS_BUCKET_PACOTES=
PORTCULLIS_FILA_URL=
PORTCULLIS_TABELA_AUDITORIA=
PORTCULLIS_CLUSTER_ECS=
PORTCULLIS_TASK_DEFINITION=
PORTCULLIS_SUBNETS=
PORTCULLIS_SECURITY_GROUP=

# Nomes dos parâmetros no SSM — nunca os valores
PORTCULLIS_PARAM_CHAVE_APP=/portcullis/github/chave-privada
PORTCULLIS_PARAM_SEGREDO_WEBHOOK=/portcullis/github/segredo-webhook
PORTCULLIS_GITHUB_APP_ID=

# Nome do parametro do LLM no SSM — nunca o valor
PORTCULLIS_PARAM_CHAVE_LLM=/portcullis/llm/chave
PORTCULLIS_PARAM_MODELO_LLM=/portcullis/llm/modelo
