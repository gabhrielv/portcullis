# Copie para .env e preencha. O .env está no .gitignore.
AWS_REGION=us-east-1

# Preenchidos pelos outputs do Terraform
ADUANA_BUCKET_PACOTES=
ADUANA_FILA_URL=
ADUANA_TABELA_AUDITORIA=
ADUANA_CLUSTER_ECS=
ADUANA_TASK_DEFINITION=
ADUANA_SUBNETS=
ADUANA_SECURITY_GROUP=

# Nomes dos parâmetros no SSM — nunca os valores
ADUANA_PARAM_CHAVE_APP=/aduana/github/chave-privada
ADUANA_PARAM_SEGREDO_WEBHOOK=/aduana/github/segredo-webhook
ADUANA_GITHUB_APP_ID=
